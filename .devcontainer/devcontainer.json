{
  "name": "photo-gallery",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "forwardPorts": [5173, 8080, 5432],
  "portsAttributes": {
    "5173": { "label": "Vite (web)" },
    "8080": { "label": "API" },
    "5432": { "label": "Postgres" }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.30.3 --activate && pnpm install && pnpm db:migrate",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
