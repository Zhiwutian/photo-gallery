PORT=8080
# Comma-separated for multiple dev origins if needed
CORS_ORIGIN=http://localhost:5173

# Required — default matches this repo's standalone Docker compose / photo-gallery devcontainer.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/photogallery?sslmode=disable
#
# If this repo lives under /workspace inside the bible-support devcontainer, port 5432 is
# already Postgres for bible-support (user/password from server/.env.example, e.g. dev:dev),
# not postgres:postgres. Create a DB once (e.g. createdb photogallery), then use:
# DATABASE_URL=postgresql://dev:dev@127.0.0.1:5432/photogallery?sslmode=disable
# See docs/development/nested-workspace-bible-support.md
# SESSION_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# PUBLIC_WEB_ORIGIN=http://localhost:5173
